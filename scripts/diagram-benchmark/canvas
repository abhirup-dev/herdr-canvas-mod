#!/bin/bash
set -euo pipefail
side="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$side/config.sh"
export CANVAS_SIDECAR_PORT="$port" HERDR_APP_HOME="$side/app" HERDR_DRAW_LOGS="$side/logs"
export HERDR_DRAW_BOARDS="$side/boards" HC_SOCKET="$side/no-core.sock" HC_TERMINAL_ID=release-audit
started=$(python3 -c 'import time; print(time.time())')
code=0
bun "$root/cli/herdr-draw.mjs" canvas "$@" || code=$?
ended=$(python3 -c 'import time; print(time.time())')
jq -nc --arg who "${AUDIT_ACTOR:-agent}" --arg start "$started" --arg end "$ended" --arg cmd "${1:-}" --arg op "${2:-}" --argjson code "$code" '{actor:$who, start:($start|tonumber), end:($end|tonumber),cmd:$cmd,op:$op,code:$code}' >>"$side/actions.jsonl"
exit "$code"
